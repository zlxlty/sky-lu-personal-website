---
import { getProjects } from "@/content/queries";
import {
  Panel,
  PanelContent,
  PanelRuleBand,
} from "@/components/blueprint/Panel";
import { StripeSeparator } from "@/components/blueprint/StripeSeparator";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import { ArrowUpRight } from "@/components/blueprint/ArrowUpRight";
import IndexHeading from "@/components/content/IndexHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";

const projects = await getProjects();
---

<BaseLayout
  title={`Projects — ${profile.name}`}
  description="Selected work in edge infrastructure, efficient AI serving, and network systems."
>
  <IndexHeading
    title="Projects"
    eyebrow={`Selected work / ${String(projects.length).padStart(2, "0")} projects`}
    description="Systems built around real constraints: latency, throughput, and the distance between an idea and production."
  />
  {
    projects.map((project, index) => (
      <Panel aria-labelledby={`project-${project.id}`}>
        <PanelContent className="py-7 sm:py-9">
          <p class="mb-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs tracking-wide uppercase">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span aria-hidden="true">/</span>
            {project.data.context}
            <span aria-hidden="true">/</span>
            {project.data.category}
          </p>
          <div class="grid items-start gap-6 sm:grid-cols-[1fr_9rem] sm:gap-8">
            <div class="min-w-0">
              <h2
                id={`project-${project.id}`}
                class="m-0 font-heading text-3xl font-medium tracking-tight"
              >
                <a
                  href={`/projects/${project.id}`}
                  class="inline-flex max-w-full items-baseline gap-3"
                >
                  <span class="min-w-0">
                    <SketchUnderline
                      text={project.data.title}
                      seed={`project:${project.id}`}
                    />
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-xl">
                    <ArrowUpRight />
                  </span>
                </a>
              </h2>
              <p class="mt-3 mb-5 max-w-lg text-base leading-relaxed">
                {project.data.description}
              </p>
              <ul
                aria-label="Technologies and topics"
                class="m-0 flex list-none flex-wrap gap-x-3 gap-y-2 p-0 font-mono text-xs"
              >
                {project.data.tags.map((tag) => (
                  <li>[{tag}]</li>
                ))}
              </ul>
            </div>
            {project.data.results[0] && (
              <p class="m-0 flex items-baseline gap-3 sm:block sm:pt-1">
                <span class="block shrink-0 font-heading text-3xl font-medium tracking-tight">
                  {project.data.results[0].value}
                </span>
                <span class="mt-2 block font-mono text-xs leading-5">
                  {project.data.results[0].label}
                </span>
              </p>
            )}
          </div>
        </PanelContent>
        <PanelRuleBand />
      </Panel>
    ))
  }
  <StripeSeparator />
  <Panel
    ><PanelContent
      className="flex flex-wrap items-center justify-between gap-4 py-6 text-sm"
      ><span>More from the notebook</span><a
        class="inline-flex min-h-10 items-center gap-3"
        href="/writing"
        ><SketchUnderline text="Writings" />
        <span aria-hidden="true">→</span></a
      ></PanelContent
    ></Panel
  >
</BaseLayout>
