---
import { getWriting } from "@/content/queries";
import { StripeSeparator } from "@/components/blueprint/StripeSeparator";
import IndexHeading from "@/components/content/IndexHeading.astro";
import WritingList from "@/components/content/WritingList.astro";
import WritingIdeas from "@/components/content/WritingIdeas.astro";
import { writingsIntro } from "@/data/writings";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";

const entries = await getWriting();
---

<BaseLayout
  title={`Writings — ${profile.name}`}
  description={`Thoughts on cooking, jazz guitar, and learning abstractions by ${profile.name}.`}
>
  <IndexHeading
    title="Writings"
    eyebrow="Thoughts / A notebook in the making"
    description={writingsIntro}
  />
  {entries.length > 0 && <WritingList {entries} />}
  <WritingIdeas />
  <StripeSeparator />
</BaseLayout>
