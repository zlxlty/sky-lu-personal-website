---
import { render, type CollectionEntry } from "astro:content";
import { getWriting } from "@/content/queries";
import { formatContentDate } from "@/lib/content";
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";

export async function getStaticPaths() {
  const entries = await getWriting();
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[index + 1] },
  }));
}
interface Props {
  entry: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}
const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ReadingLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow="Writings / Notes"
  backHref="/writing"
  backLabel="All writings"
  {headings}
>
  <div slot="metadata" class="flex flex-wrap gap-x-5 gap-y-3 font-mono text-xs">
    <time datetime={entry.data.publishedAt.toISOString()}
      >{formatContentDate(entry.data.publishedAt)}</time
    >
    {
      entry.data.updatedAt && (
        <span>
          Updated{" "}
          <time datetime={entry.data.updatedAt.toISOString()}>
            {formatContentDate(entry.data.updatedAt)}
          </time>
        </span>
      )
    }
    {entry.data.tags.map((tag) => <span>[{tag}]</span>)}
  </div>
  <Content />
  {
    next && (
      <a
        slot="next"
        class="inline-flex min-h-10 max-w-full items-center gap-2"
        href={`/writing/${next.id}`}
      >
        <span class="min-w-0">
          <SketchUnderline text={`Next: ${next.data.title}`} />
        </span>
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</ReadingLayout>
