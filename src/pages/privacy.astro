---
import { Panel, PanelContent } from "@/components/blueprint/Panel";
import IndexHeading from "@/components/content/IndexHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout
  title={`Privacy — ${profile.name}`}
  description="How this site handles preferences, external links, and music."
>
  <IndexHeading
    title="Privacy"
    eyebrow="About this site / Your visit"
    description="A small personal website, with a small data footprint."
  />
  <Panel>
    <PanelContent className="space-y-8 py-10 sm:py-12">
      <section aria-labelledby="site-data" class="max-w-prose">
        <h2 id="site-data" class="font-heading text-2xl">On this site</h2>
        <p class="mt-3 mb-0">
          This site does not use analytics, advertising trackers, or accounts.
          Its code does not set cookies. When you choose a light or dark theme,
          that preference is saved in your browser’s local storage. You can
          remove it by clearing this site’s data in your browser.
        </p>
        <p class="mt-3 mb-0">
          Loading a page sends ordinary connection information, including your
          IP address and browser details, to the server delivering it.
        </p>
      </section>
      <section aria-labelledby="music-links" class="max-w-prose">
        <h2 id="music-links" class="font-heading text-2xl">
          Music & external links
        </h2>
        <p class="mt-3 mb-0">
          When you play a recording on this site, your browser requests its
          audio file from the host serving that recording. Playback state stays
          in the current page; this site does not save a listening history.
        </p>
        <p class="mt-3 mb-0">
          Once you follow a link to another website, that service handles your
          visit under its own privacy policy.
        </p>
      </section>
    </PanelContent>
  </Panel>
</BaseLayout>
