---
import { PanelRuleBand } from "@/components/blueprint/Panel";
import { StripeSeparator } from "@/components/blueprint/StripeSeparator";
import HomeHero from "@/components/site/HomeHero.astro";
import HomeOverview from "@/components/site/HomeOverview.astro";
import HomeResearch from "@/components/site/HomeResearch.astro";
import HomeSelectedWork from "@/components/site/HomeSelectedWork.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout
  title={profile.name}
  description={profile.siteDescription}
  mainLabel={`${profile.name} personal website`}
>
  <HomeHero />
  <StripeSeparator />
  <PanelRuleBand />
  <HomeOverview />
  <PanelRuleBand />
  <HomeResearch />
  <PanelRuleBand />
  <HomeSelectedWork />
  <StripeSeparator />
</BaseLayout>
