---
import {
  Panel,
  PanelContent,
  PanelRuleBand,
} from "@/components/blueprint/Panel";
import { StripeSeparator } from "@/components/blueprint/StripeSeparator";
import HomeHero from "@/components/site/HomeHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { profile } from "@/data/profile";
---

<BaseLayout
  title={profile.name}
  description={profile.siteDescription}
  mainLabel={`${profile.name} personal website`}
>
  <HomeHero />
  <StripeSeparator />
  <PanelRuleBand />
  <Panel
    id="after-guitar"
    tabIndex={-1}
    aria-label="Explore more"
    className="scroll-mt-16"
  >
    <PanelContent
      className="flex flex-wrap items-center justify-between gap-4 py-7 text-sm"
    >
      <span>Explore the work behind the strings.</span>
      <a href="/projects">Selected projects ↗</a>
    </PanelContent>
  </Panel>
</BaseLayout>
