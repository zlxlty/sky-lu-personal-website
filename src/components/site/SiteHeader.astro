---
import { BlueprintNavbar } from "@/components/blueprint/BlueprintNavbar";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import ThemeToggle from "@/components/theme/ThemeToggle.astro";
import { profile } from "@/data/profile";
import SiteWordmark from "./SiteWordmark.astro";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigation = [
  { href: "/writing", label: "Writings" },
  { href: "/projects", label: "Projects" },
  { href: "/people", label: "People" },
];
---

<BlueprintNavbar
  aria-label="Site header"
  data-home-header={currentPath === "/" ? "" : undefined}
>
  <div
    class="flex min-w-0 flex-1 items-center justify-between gap-2 pr-2 sm:gap-3"
  >
    {
      currentPath !== "/" && (
        <a
          href="/"
          aria-label={`${profile.name} — Home`}
          class="inline-flex min-h-10 shrink-0 items-center"
        >
          <SiteWordmark aria-hidden="true" class="text-xl sm:text-2xl" />
        </a>
      )
    }
    <nav
      aria-label="Main navigation"
      class="ml-auto flex items-center gap-2 sm:gap-5"
    >
      {
        navigation.map(({ href, label }) => (
          <a
            href={href}
            aria-current={
              currentPath === href
                ? "page"
                : currentPath.startsWith(`${href}/`)
                  ? "location"
                  : undefined
            }
            class="inline-flex min-h-10 items-center text-xs sm:text-sm"
          >
            <SketchUnderline text={label} seed={`navigation:${href}`} />
          </a>
        ))
      }
    </nav>
  </div>
  <ThemeToggle />
</BlueprintNavbar>

<script>
  import { initializeHomeHeader } from "@/lib/home-header";

  initializeHomeHeader();
</script>
