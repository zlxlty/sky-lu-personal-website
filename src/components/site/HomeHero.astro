---
import { Panel, PanelContent } from "@/components/blueprint/Panel";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import { GuitarPlayer } from "@/components/guitar/GuitarPlayer";
import type { GuitarLayout } from "@/components/guitar/string-geometry";
import { profile } from "@/data/profile";
import SiteWordmark from "./SiteWordmark.astro";

const guitarLayout = {
  width: 800,
  height: 500,
  hole: { x: 592, y: 270, radius: 128 },
  angle: 35,
  length: 1500,
  spacing: 22,
} satisfies GuitarLayout;
---

<Panel id="hero-panel" aria-labelledby="hero-heading">
  <div class="relative grid items-end md:grid-cols-[0.85fr_1.15fr]">
    <PanelContent
      className="z-10 min-w-0 pt-10 pb-6 md:col-start-1 md:row-start-1 md:pt-14 md:pb-12"
    >
      <div data-hero-copy>
        <p
          data-slot="eyebrow"
          class="mb-4 font-mono text-[10px] tracking-widest uppercase opacity-45"
        >
          Sincere,Compassionate,Tolerant
        </p>
        <div data-name-hint class="relative w-fit">
          <h1 id="hero-heading" class="m-0 font-heading text-4xl md:text-5xl">
            <SiteWordmark>
              <span
                slot="first-name"
                data-name-hint-trigger
                tabindex="0"
                aria-describedby="hero-name-hint"
                title={`Legal Name: ${profile.legalName}`}
                class="cursor-help">sky</span
              >
            </SiteWordmark>
          </h1>
          <span
            id="hero-name-hint"
            role="tooltip"
            hidden
            class="absolute bottom-full left-0 z-30 w-max max-w-72 pb-2"
          >
            <span
              class="block rounded-(--radius-small) bg-foreground px-3 py-1.5 font-mono text-xs leading-normal font-normal tracking-normal text-background shadow-lg"
            >
              Legal Name: {profile.legalName}
            </span>
          </span>
        </div>
        <p class="mt-4 mb-0 max-w-sm text-sm leading-relaxed">
          {profile.introduction}
        </p>
      </div>
    </PanelContent>
    <div
      class="relative w-full min-w-0 md:static md:col-span-2 md:col-start-1 md:row-start-1"
    >
      <!-- Keep the exit reachable while the touch surface is on screen. -->
      <div class="pointer-events-none sticky top-14 z-20 -mb-14 h-14 md:hidden">
        <a
          href="#after-guitar"
          class="pointer-events-auto absolute top-1.5 left-2 inline-flex min-h-11 items-center gap-1.5 rounded-(--radius-small) bg-background/95 px-2 font-mono text-xs"
        >
          <SketchUnderline text="Skip guitar" seed="hero:skip-guitar" />
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5 shrink-0"
          >
            <path d="m4 9 4 4 4-4M8 13V3"></path>
          </svg>
        </a>
      </div>
      <GuitarPlayer
        client:load
        layout={guitarLayout}
        className="mx-auto max-w-lg md:max-w-none md:[&_[data-guitar-viewport]]:overflow-visible [&_[data-guitar]]:ml-[-135%] [&_[data-guitar]]:w-[250%] [&_[data-guitar]]:-translate-y-[4%] md:[&_[data-guitar]]:ml-0 md:[&_[data-guitar]]:w-full md:[&_[data-guitar]]:translate-y-0 md:[&_[data-guitar]]:overflow-visible md:[&_[data-guitar]]:[clip-path:inset(calc(-1*var(--size-site-header))_0_0)]"
      />
    </div>
  </div>
</Panel>

<script>
  const hint = document.querySelector<HTMLElement>("[data-name-hint]");
  const trigger = hint?.querySelector<HTMLElement>("[data-name-hint-trigger]");
  const tooltip = hint?.querySelector<HTMLElement>('[role="tooltip"]');

  if (hint && trigger && tooltip) {
    // Keep the native title as the no-JavaScript fallback only.
    trigger.removeAttribute("title");
    const show = () => {
      tooltip.hidden = false;
    };
    const hide = () => {
      tooltip.hidden = true;
    };

    trigger.addEventListener("pointerenter", show);
    trigger.addEventListener("focus", show);
    // The padded tooltip is part of the same hover region, so it can be read
    // or selected without disappearing as the pointer leaves the word.
    hint.addEventListener("pointerleave", () => {
      if (document.activeElement !== trigger) hide();
    });
    trigger.addEventListener("blur", () => {
      if (!hint.matches(":hover")) hide();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hide();
    });
    window.addEventListener("pagehide", hide);
  }
</script>
