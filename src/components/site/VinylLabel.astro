---
interface Props {
  design?: number;
}
const { design = 0 } = Astro.props;
---

<!-- Five asymmetric label prints. Each record keeps its playlist-index design. -->
<g data-vinyl-design="0" data-active={design === 0 ? "" : undefined}>
  <path d="M83 85A23 23 0 0 1 114 82" stroke-width="2.5" opacity=".6"></path>
  <path d="M90 90H109M94 94H105" stroke-width=".8" opacity=".5"></path>
</g>
<g data-vinyl-design="1" data-active={design === 1 ? "" : undefined}>
  <path
    d="M84 103L101 82M89 109L108 85M95 114L113 92"
    stroke-width="1.6"
    opacity=".5"></path>
  <path d="M106 113H114M109 109H116" stroke-width=".8" opacity=".65"></path>
</g>
<g data-vinyl-design="2" data-active={design === 2 ? "" : undefined}>
  <path d="M103 85A14 14 0 1 1 89 99" stroke-width="1.4" opacity=".6"></path>
  <path d="M106 90A8 8 0 1 1 96 104" stroke-width=".8" opacity=".4"></path>
  <path d="M87 87L91 91M84 93L89 95M94 83L96 88" stroke-width="1.2" opacity=".5"
  ></path>
</g>
<g data-vinyl-design="3" data-active={design === 3 ? "" : undefined}>
  <path d="M83 110A20 20 0 0 1 83 90" stroke-width="2.4" opacity=".5"></path>
  <path d="M105 87V113M110 90V110M115 94V106" stroke-width="1.3" opacity=".55"
  ></path>
  <path d="M90 87H98M91 113H98" stroke-width=".8" opacity=".4"></path>
</g>
<g data-vinyl-design="4" data-active={design === 4 ? "" : undefined}>
  <path
    d="M100 77A23 23 0 0 1 123 100H115A15 15 0 0 0 100 85Z"
    fill="currentColor"
    stroke="none"
    opacity=".35"></path>
  <path d="M88 109H108M92 113H103M87 89H94" stroke-width="1" opacity=".6"
  ></path>
</g>

<style>
  [data-vinyl-design]:not([data-active]) {
    display: none;
  }
</style>
