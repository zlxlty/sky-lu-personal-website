---
import { Panel, PanelContent } from "@/components/blueprint/Panel";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import { research } from "@/data/research";
import { getProjects } from "@/content/queries";

const projects = (await getProjects()).filter((project) =>
  research.projectIds.includes(project.id),
);
---

<Panel
  id="research"
  aria-labelledby="research-heading"
  className="scroll-mt-16"
>
  <PanelContent className="py-8 sm:py-10">
    <p class="m-0 mb-6 font-mono text-xs tracking-wide uppercase">
      02 / Research
    </p>
    <div class="grid gap-6 sm:grid-cols-[1fr_1.8fr] sm:gap-10">
      <div>
        <h2
          id="research-heading"
          class="m-0 font-heading text-2xl font-medium tracking-tight"
        >
          <a href={research.group.href}>
            <SketchUnderline text={research.group.label} seed="home:atlas" />
          </a>
        </h2>
        <p class="mt-2 mb-0 text-sm">{research.institution}</p>
        <p class="mt-3 mb-0 text-xs leading-relaxed text-muted-foreground">
          {research.role}
        </p>
      </div>
      <div class="min-w-0">
        <p class="m-0 text-base leading-relaxed">{research.summary}</p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <a
            href={research.collaborator.href}
            class="inline-flex min-h-11 items-center gap-2"
          >
            <SketchUnderline
              text={research.collaborator.label}
              seed="home:collaborator"
            />
            <span aria-hidden="true">↗</span>
          </a>
          {
            projects.map((project) => (
              <a
                href={`/projects/${project.id}`}
                class="inline-flex min-h-11 items-center gap-2"
              >
                <SketchUnderline
                  text={`About ${project.data.title}`}
                  seed={`home:research:${project.id}`}
                />
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </PanelContent>
</Panel>
