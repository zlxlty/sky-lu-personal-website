---
import { Panel, PanelContent } from "@/components/blueprint/Panel";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import { education } from "@/data/profile";

const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Panel
  id="after-guitar"
  tabIndex={-1}
  aria-label="Explore more"
  className="scroll-mt-16"
>
  <PanelContent className="py-8 sm:py-10">
    <p class="m-0 mb-6 font-mono text-xs tracking-wide uppercase">
      01 / A little context
    </p>
    <div class="grid gap-8 sm:grid-cols-[1.3fr_1fr] sm:gap-12">
      <div class="min-w-0">
        <h2 class="m-0 font-heading text-2xl font-medium tracking-tight">
          Systems, and the ideas underneath.
        </h2>
        <p class="mt-4 mb-0 text-sm leading-relaxed">
          Most of my work is in distributed systems: network communication, edge
          infrastructure, and efficient AI serving.
        </p>
        <p class="mt-3 mb-0 text-sm leading-relaxed">
          Alongside that, I’m learning category theory and type theory. Away
          from the desk, I like cooking and playing jazz guitar.
        </p>
        <a
          href="#selected-work"
          class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm"
        >
          <SketchUnderline text="Selected projects" seed="home:projects" />
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <dl class="m-0 space-y-6">
        {
          education.map((entry) => (
            <div>
              <dt class="font-heading text-base font-medium">
                {entry.institution}
              </dt>
              <dd class="m-0 mt-1 text-sm leading-relaxed">{entry.degree}</dd>
              <dd class="m-0 mt-2 font-mono text-xs leading-5 text-muted-foreground">
                {entry.graduation.status === "expected" ? "Expected " : ""}
                <time datetime={entry.graduation.date}>
                  {monthYear.format(
                    new Date(`${entry.graduation.date}-01T00:00:00Z`),
                  )}
                </time>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </PanelContent>
</Panel>
