---
import { Panel, PanelContent, PanelHeader } from "@/components/blueprint/Panel";
import { SketchUnderline } from "@/components/blueprint/SketchUnderline";
import HorizontalTimeline from "@/components/blueprint/HorizontalTimeline.astro";
import { lifeTimeline } from "@/data/timeline";
import TextHint from "./TextHint.astro";
---

<Panel
  id="after-guitar"
  tabIndex={-1}
  aria-label="Explore more"
  className="scroll-mt-16 focus-visible:outline-none"
>
  <PanelHeader className="py-4">
    <p class="m-0 mb-6 font-mono text-xs tracking-wide uppercase">
      01 / A little honesty
    </p>
    <div class="grid gap-6 sm:grid-cols-[1.2fr_1fr] sm:items-end sm:gap-12">
      <h2
        class="m-0 max-w-xs font-heading text-3xl leading-tight font-medium tracking-tight sm:text-[40px]"
      >
        This is <span
          class="font-(family-name:--font-handwritten-family) text-[1.15em] font-normal"
          >[not]</span
        >
        <br />a résumé.
      </h2>
      <div
        class="m-0 w-fit max-w-full justify-self-end text-left text-sm leading-relaxed"
      >
        <p class="m-0">I try to keep the professional façade to a</p>
        <p class="m-0">minimum here</p>
      </div>
    </div>
  </PanelHeader>
  <Panel aria-labelledby="overview-people-heading">
    <PanelContent
      className="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-10"
    >
      <h3
        id="overview-people-heading"
        class="m-0 font-mono text-xs leading-7 font-normal tracking-wide text-muted-foreground uppercase"
      >
        Drives
      </h3>
      <p class="m-0 text-sm leading-7">
        The people around me have always been my strongest motivation. I try to
        be sincere, act with compassion, and make room for difference. For me,
        that's a way of getting through the world, not a claim to moral high
        ground.
      </p>
    </PanelContent>
  </Panel>
  <Panel aria-labelledby="overview-communities-heading">
    <PanelContent
      className="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-10"
    >
      <h3
        id="overview-communities-heading"
        class="m-0 font-mono text-xs leading-7 font-normal tracking-wide text-muted-foreground uppercase"
      >
        Communities
      </h3>
      <p class="m-0 text-sm leading-7">
        That's why I have a track record of being drawn to places with a little,
        perhaps silly, idealism. [
        <a href="https://www.uwcchina.org/en" class="whitespace-nowrap"
          ><SketchUnderline text="UWCCSC" seed="home:community:uwccsc" /></a
        >, <a href="https://info.xacademy.cc/" class="whitespace-nowrap"
          ><SketchUnderline
            text="X Academy"
            seed="home:community:x-academy"
          /></a
        >] and to finding ways to contribute to them.
      </p>
    </PanelContent>
  </Panel>
  <Panel aria-labelledby="overview-daily-heading">
    <PanelContent
      className="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-10"
    >
      <h3
        id="overview-daily-heading"
        class="m-0 font-mono text-xs leading-7 font-normal tracking-wide text-muted-foreground uppercase"
      >
        Enjoyments
      </h3>
      <p class="m-0 text-sm leading-7">
        For myself, I devote most of my time studying distributed inference
        systems, learning jazz guitar, and cooking. Sometimes I go bouldering,
        play badminton, or <TextHint
          id="pool-hint"
          label="pool"
          text="The dry one. Tables, cues, that sort of thing."
        />.
      </p>
    </PanelContent>
  </Panel>
  <Panel aria-labelledby="overview-timeline-heading">
    <PanelContent
      className="grid gap-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-10"
    >
      <h3
        id="overview-timeline-heading"
        class="m-0 font-mono text-xs leading-7 font-normal tracking-wide text-muted-foreground uppercase"
      >
        Timeline
      </h3>
      <HorizontalTimeline
        id="life-timeline"
        label="Life events, newest first"
        entries={lifeTimeline}
      />
    </PanelContent>
  </Panel>
</Panel>
