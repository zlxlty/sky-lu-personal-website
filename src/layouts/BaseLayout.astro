---
import { BlueprintPage } from "@/components/blueprint/BlueprintPage";
import { BlueprintNavbar } from "@/components/blueprint/BlueprintNavbar";
import ThemeToggle from "@/components/theme/ThemeToggle.astro";
import {
  DARK_THEME_QUERY,
  THEME_COLORS,
  THEME_COLOR_SCHEMES,
  THEME_STORAGE_KEY,
} from "@/lib/theme";
import "@/styles/global.css";
import geistLatinUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  lang?: string;
  mainLabel?: string;
}

const { title, description, lang = "en", mainLabel } = Astro.props;
const mainId = "main-content";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={THEME_COLORS.light}
      data-theme-light={THEME_COLORS.light}
      data-theme-dark={THEME_COLORS.dark}
    />
    <script
      is:inline
      define:vars={{
        darkThemeQuery: DARK_THEME_QUERY,
        darkThemeColorScheme: THEME_COLOR_SCHEMES.dark,
        lightThemeColorScheme: THEME_COLOR_SCHEMES.light,
        storageKey: THEME_STORAGE_KEY,
      }}
    >
      (() => {
        const root = document.documentElement;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          if (value === "light" || value === "dark") storedTheme = value;
        } catch {
          // System preference remains available when storage is blocked.
        }

        const theme =
          storedTheme ??
          (window.matchMedia(darkThemeQuery).matches ? "dark" : "light");
        const metaColor =
          theme === "dark"
            ? themeColor?.dataset.themeDark
            : themeColor?.dataset.themeLight;

        root.dataset.theme = theme;
        root.style.colorScheme =
          theme === "dark" ? darkThemeColorScheme : lightThemeColorScheme;
        if (metaColor) themeColor?.setAttribute("content", metaColor);
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={geistLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <nav aria-label="Skip links">
      <a
        class="fixed top-3 left-3 z-[1000] -translate-y-[calc(100%+1.5rem)] rounded-(--radius-small) border border-(--color-rule-strong) bg-(--color-surface-raised) px-3 py-2 font-mono text-(length:--text-small) text-foreground shadow-[0_0.25rem_1rem_rgb(43_39_36/12%)] transition-transform duration-(--duration-feedback) ease-(--ease-standard) focus-visible:translate-y-0"
        href={`#${mainId}`}
      >
        Skip to content
      </a>
    </nav>
    <BlueprintNavbar aria-label="Site header">
      <ThemeToggle />
    </BlueprintNavbar>
    <BlueprintPage id={mainId} aria-label={mainLabel}>
      <slot />
    </BlueprintPage>
  </body>
</html>
