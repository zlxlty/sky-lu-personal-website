---
import { BlueprintPage } from "@/components/blueprint/BlueprintPage";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import {
  DEFAULT_THEME,
  THEME_COLORS,
  THEME_COLOR_SCHEMES,
  THEME_STORAGE_KEY,
} from "@/lib/theme";
import "@/styles/global.css";
import geistLatinUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  lang?: string;
  mainLabel?: string;
}

const { title, description, lang = "en", mainLabel } = Astro.props;
const mainId = "main-content";
const canonicalUrl =
  Astro.site &&
  !Astro.url.pathname.startsWith("/lab") &&
  Astro.url.pathname !== "/404"
    ? new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site)
    : undefined;
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta
      name="theme-color"
      content={THEME_COLORS[DEFAULT_THEME]}
      data-theme-light={THEME_COLORS.light}
      data-theme-dark={THEME_COLORS.dark}
    />
    <script
      is:inline
      define:vars={{
        defaultTheme: DEFAULT_THEME,
        darkThemeColorScheme: THEME_COLOR_SCHEMES.dark,
        lightThemeColorScheme: THEME_COLOR_SCHEMES.light,
        storageKey: THEME_STORAGE_KEY,
      }}
    >
      (() => {
        const root = document.documentElement;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        let storedTheme = null;

        try {
          const value = localStorage.getItem(storageKey);
          if (value === "light" || value === "dark") storedTheme = value;
        } catch {
          // Keep the dark default when storage is blocked.
        }

        const theme = storedTheme ?? defaultTheme;
        const metaColor =
          theme === "dark"
            ? themeColor?.dataset.themeDark
            : themeColor?.dataset.themeLight;

        root.dataset.theme = theme;
        root.style.colorScheme =
          theme === "dark" ? darkThemeColorScheme : lightThemeColorScheme;
        if (metaColor) themeColor?.setAttribute("content", metaColor);
      })();
    </script>
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={geistLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body id="top">
    <nav aria-label="Skip links">
      <a
        class="fixed top-3 left-3 z-[1000] -translate-y-[calc(100%+1.5rem)] rounded-(--radius-small) border border-(--color-rule-strong) bg-(--color-surface-raised) px-3 py-2 font-mono text-(length:--text-small) text-foreground shadow-[0_0.25rem_1rem_rgb(43_39_36/12%)] transition-transform duration-(--duration-feedback) ease-(--ease-standard) focus-visible:translate-y-0"
        href={`#${mainId}`}
      >
        Skip to content
      </a>
    </nav>
    <BlueprintPage id={mainId} aria-label={mainLabel}>
      <SiteHeader slot="header" />
      <slot />
      <SiteFooter slot="footer" />
    </BlueprintPage>
    <span data-theme-status class="sr-only" aria-live="polite"></span>
    <script>
      import "@/lib/sketch-underline";
    </script>
  </body>
</html>
