{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-lu-website-preview",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "env": {
    "preview": {
      "name": "sky-lu-website-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
    },
    "production": {
      "name": "sky-lu-website",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "skylu.me", "custom_domain": true }],
    },
  },
}
